# AVAIL DISTRIBUTION: the EasySchematic API (api/src, unmodified Hono app) on Node,
# with SQLite + file storage instead of Cloudflare D1/R2. See api-avail/.
#
# Uses its own Dockerfile.api-avail.dockerignore: the root .dockerignore drops
# api/src and api/migrations, which this image is built from.

# Build stage: bundle api-avail + api/src + the bundled device library into one file.
FROM node:22-bookworm AS builder
WORKDIR /app
COPY api/package.json api/package-lock.json ./api/
RUN cd api && npm ci --omit=dev
COPY api-avail/package.json api-avail/package-lock.json ./api-avail/
RUN cd api-avail && npm ci
COPY src ./src
COPY docs/avail ./docs/avail
# Worklist follow-ups (worklist-followups.json) are bundled into apply:worklist.
COPY tools/avail/incoming/worklist-followups.json ./tools/avail/incoming/
COPY api/src ./api/src
COPY api-avail ./api-avail
RUN cd api-avail && npm run build && npm prune --omit=dev

# Runtime stage: same Debian release as the builder, so better-sqlite3's native
# addon built/downloaded there loads here.
FROM node:22-bookworm-slim
# Commit the image was built from: recorded in the audit log with every CLI run.
ARG SOURCE_COMMIT=unknown
ENV AVAIL_COMMIT=$SOURCE_COMMIT
ENV NODE_ENV=production \
    PORT=8787 \
    DATA_DIR=/data \
    MIGRATIONS_DIR=/app/migrations \
    AVAIL_MIGRATIONS_DIR=/app/migrations-avail \
    AVAIL_LIBRARY_DIR=/app/library/avail \
    AVAIL_CATALOG_DIR=/app/library/catalog \
    AVAIL_WORKLIST_FILE=/app/incoming/Library_worklist_engineers_solutions.xlsx \
    AVAIL_VENDOR_RESPONSES_FILE=/app/incoming/vendor-responses.json
WORKDIR /app
COPY --from=builder /app/api-avail/node_modules ./node_modules
COPY --from=builder /app/api-avail/dist ./dist
COPY api/migrations ./migrations
COPY api-avail/migrations ./migrations-avail
# Curated library for `npm run import:avail` (library/avail + library/hidden.json), catalog for `npm run import:catalog`.
COPY library ./library
# Engineers' worklist solutions (apply:worklist, export:vendor-requests), vendors' answers (apply:vendor-responses).
COPY tools/avail/incoming ./incoming
# Scripts for `docker compose exec api npm run import:upstream` and the like.
COPY api-avail/package.runtime.json ./package.json
RUN mkdir -p /data && chown node:node /data
USER node
VOLUME ["/data"]
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
CMD ["node", "--enable-source-maps", "dist/server.mjs"]
