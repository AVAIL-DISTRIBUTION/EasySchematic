# AVAIL DISTRIBUTION build of the EasySchematic frontend.
#
# Differs from the upstream Dockerfile in one place: the build runs
# `generate-fallback && vite build` without `tsc -b`. .dockerignore leaves
# api/src and devices out of the build context, and the TypeScript project
# references point at them, so `tsc -b` fails inside Docker. Type-checking
# stays in CI (`npm run build` in ci.yml), where the full tree is checked out.

# Build stage
FROM node:22-bookworm AS builder
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
# postinstall runs patch-package, so the patches must be in place before npm ci.
COPY patches ./patches
RUN npm ci
COPY . .
# Deployment addresses are baked in at build time (Vite inlines import.meta.env),
# passed as build args so they live in CI variables, not in the code:
#   VITE_TEMPLATE_API_URL  API base, e.g. https://sch.avail-int.com/api
#   VITE_DEVICES_URL       device database site linked from the editor
#   VITE_AUTH_GOOGLE_ONLY  1 = login dialog offers Google only
#   VITE_DOCS_URL          our documentation site for Help → Documentation (unset = no link)
# VITE_AVAIL=1 turns on the AVAIL interface (sign-in gate instead of the landing page,
# branding, AVAIL defaults); it is what makes this image ours, so it defaults to 1.
# An arg passed as an empty string is unset before the build: the app tests these
# with `??`, so "" would replace the default with an empty URL.
ARG VITE_TEMPLATE_API_URL
ARG VITE_DEVICES_URL
ARG VITE_AUTH_GOOGLE_ONLY
ARG VITE_DOCS_URL
ARG VITE_AVAIL=1
# Commit of this build (no .git in the context): shown in About, links its source.
ARG SOURCE_COMMIT
RUN for v in VITE_TEMPLATE_API_URL VITE_DEVICES_URL VITE_AUTH_GOOGLE_ONLY VITE_DOCS_URL VITE_AVAIL; do \
      eval "[ -n \"\${$v}\" ]" || unset "$v"; \
    done; \
    npm run generate-fallback && npx vite build

# Production stage
FROM nginx:bookworm
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
