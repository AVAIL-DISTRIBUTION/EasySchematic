{
  "name": "easyschematic-api-avail-runtime",
  "private": true,
  "type": "module",
  "description": "package.json of the API image (/app): scripts for docker compose exec api npm run …",
  "scripts": {
    "start": "node --enable-source-maps dist/server.mjs",
    "import:upstream": "node --enable-source-maps dist/import-upstream.mjs",
    "normalize:library": "node --enable-source-maps dist/normalize-library.mjs",
    "import:avail": "node --enable-source-maps dist/import-avail.mjs",
    "apply:vendor-decisions": "node --enable-source-maps dist/apply-vendor-decisions.mjs",
    "apply:generic-plan": "node --enable-source-maps dist/apply-generic-plan.mjs"
  }
}
