# AVAIL DISTRIBUTION — settings for deploy/avail/docker-compose.yml.
# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# ---- Images -----------------------------------------------------------------
# latest, or sha-<commit> to pin both images to one build.
IMAGE_TAG=latest

# ---- Domain -----------------------------------------------------------------
# Public host name; Caddy gets the certificate for it. DNS must point here.
SITE_DOMAIN=sch.avail-int.com

# ---- API: secrets -----------------------------------------------------------
# Admin bearer token, at least 16 characters: openssl rand -hex 32
ADMIN_TOKEN=
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI: ${API_PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- API: addresses and sign-in ---------------------------------------------
# Public URL of the API (Caddy serves it under /api); builds the OAuth redirect_uri.
API_PUBLIC_URL=https://sch.avail-int.com/api
# Origins allowed to call the API with cookies and to be returned to after login.
ALLOWED_ORIGINS=https://sch.avail-int.com
# Only Google Workspace accounts of this domain may sign in (id_token hd claim).
GOOGLE_ALLOWED_DOMAIN=avail-int.com
# 1 = email (magic-link) sign-in is off; keep it off, or the domain limit is bypassable.
DISABLE_MAGIC_LINK=1
# Saved schematics per user; 0 = no limit (unset would mean upstream's 10).
MAX_SCHEMATICS_PER_USER=0
# Requests a minute per AI Assistant access token (over it: 429).
AI_TOKEN_RATE_LIMIT=120
# if-empty | always | off — seeding of the device library from the bundled templates.
SEED_LIBRARY=if-empty

# ---- Frontend (build time) --------------------------------------------------
# The frontend image is built in CI (avail-image.yml) with these as build args, not read from
# this file. VITE_DEVICES_URL stays empty: the AVAIL build has no community device site —
# proposals and the library workspace (/library) are ours.
# VITE_DEVICES_URL=

# ---- Backups (backup.sh) ----------------------------------------------------
# Where archives go on this host, and how many days to keep them.
BACKUP_DIR=/srv/easyschematic/backups
BACKUP_KEEP_DAYS=14
# Optional upload to S3 or an S3-compatible store. Empty BACKUP_S3_URI = no upload.
# e.g. s3://avail-backups/easyschematic
BACKUP_S3_URI=
# For non-AWS stores (MinIO, Yandex Object Storage, ...): https://storage.example.com
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
