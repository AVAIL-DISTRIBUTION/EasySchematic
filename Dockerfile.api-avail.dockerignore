# Build context for Dockerfile.api-avail (BuildKit picks this file over .dockerignore).
# Allow-list: only what the API image is built from.
*
!src
!api/package.json
!api/package-lock.json
!api/src
!api/migrations
!api-avail
!docs/avail
!library
!tools/avail/incoming
**/node_modules
api-avail/dist
api-avail/data
src/__tests__
# Server database snapshots (fill:catalog-ports input) and catalog archives never go into the image.
tools/avail/incoming/db
library/*.zip
